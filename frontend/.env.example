# Public URL of the site (used in email links)
NEXT_PUBLIC_SITE_URL=https://soulcraftstudio.vercel.app

# MongoDB (Atlas connection string)
MONGODB_URI=

# Session signing secret — at least 32 random characters (openssl rand -hex 32)
JWT_SECRET=

# Vercel Blob — product/category images and payment screenshots
BLOB_READ_WRITE_TOKEN=

# SMTP — transactional emails (Gmail: smtp.gmail.com / 587 / App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=
